# Reddit (no auth — uses public JSON endpoints). Just set a descriptive UA.
REDDIT_USER_AGENT=melb-map (hobby project) by u/yourusername

# DeepSeek API (OpenAI-compatible — used for suburb summarisation)
DEEPSEEK_API_KEY=

# Image generation backend. Defaults to "pollinations" (free, no key).
# Set to "replicate" and supply REPLICATE_API_TOKEN to use FLUX dev.
IMAGE_GEN_PROVIDER=pollinations
REPLICATE_API_TOKEN=
